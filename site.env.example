# MancherikalaM BigBazar - contact details
#
# On GitHub these are repository VARIABLES, not secrets:
#   Settings > Secrets and variables > Actions > Variables tab > New repository variable
# Use exactly the names below. After changing one, redeploy:
#   Actions > Deploy to GitHub Pages > Run workflow
#
# For a local preview, copy this file to .env (git ignores it), fill it in, then:
#   python tools/apply-env.py --out _preview
#   python -m http.server 8000 -d _preview
#
# Anything left empty stays a visible [BB_...] placeholder on the site, and
# the matching button shows "not added yet" instead of a broken link.

# Phone as you want it displayed. The call link strips the spaces.
BB_PHONE=+91 98765 43210

# WhatsApp: the 10-digit mobile number. Spaces, +91 and dashes are tidied up.
BB_WHATSAPP=9876543210

# Street address (Karukachal, Kottayam, Kerala are added by the page).
BB_STREET_ADDRESS=Main Road, near the junction
BB_PINCODE=686540

# Opening hours in 24-hour time, HH:MM-HH:MM, or the word closed.
BB_HOURS_MON_SAT=08:30-20:00
BB_HOURS_SUN=closed

# Right-click the shop in Google Maps; the coordinates are the first menu item.
BB_LATITUDE=9.5077
BB_LONGITUDE=76.6392

# Google Maps > Share > Send a link.
BB_MAPS_LINK=https://maps.app.goo.gl/example
# Google Maps > Share > Embed a map > copy ONLY the src="..." URL.
# A coordinate URL works too: https://maps.google.com/maps?q=LAT,LNG&z=17&output=embed
BB_MAPS_EMBED=https://maps.google.com/maps?q=9.5077,76.6392&z=17&output=embed

# Licences, as printed on the certificates.
BB_GSTIN=
BB_FSSAI=

# Social links.
BB_FACEBOOK_URL=
BB_WHATSAPP_GROUP=
